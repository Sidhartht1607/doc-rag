# copy to .env and fill in; .env is gitignored
OPENAI_API_KEY=your-key-here
# GROQ_API_KEY=your-key-here

# which LLM answers: "openai" or "groq". Default: openai if OPENAI_API_KEY is set, otherwise groq
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-5-nano
# OPENAI_REASONING_EFFORT=low        # minimal | low | medium | high
# GROQ_MODEL=qwen/qwen3.8-27b

# optional overrides
# DOCUMENT_PATH=document.pdf
# INDEX_DIR=data/index

# optional guardrails and tracing (pip install -e ".[guardrails]" and python -m spacy download en_core_web_md)
# PII_REDACTION=1                     # redact PII from the question before the LLM and the traces see it
# FAITHFULNESS_CHECK=1                # a second model scores each answer's grounding in the passages
# JUDGE_PROVIDER=groq                 # must differ from the answering model
# JUDGE_MODEL=openai/gpt-oss-120b
# MIN_FAITHFULNESS=0.7                # only after calibrating; below it the answer becomes an abstention
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db   # one trace per /ask; view with: mlflow server --backend-store-uri sqlite:///mlflow.db
